# Copia este archivo a .env.local y escribe los datos de tu proyecto de Supabase
# (Settings → API Keys). Son los mismos valores de Supabase.plist en la app de iOS.
# La URL es solo el dominio del proyecto, sin /rest/v1 ni otra ruta.
# Nunca uses la secret key: esta app corre en el navegador.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
